+# Keep this board on its existing OEM slot. Never modify BOOTCONFIG or data partitions.
+re_cs_07_select_slot() {
+	local cfgpart slot kern root
+	cfgpart="$(find_mmc_part '0:BOOTCONFIG')" || return 1
+	[ -b "$cfgpart" ] || { echo 'RE-CS-07: BOOTCONFIG block device is missing' >&2; return 1; }
+	slot="$(hexdump -v -n 1 -s 148 -e '1/1 "%u"' "$cfgpart")" || return 1
+	case "$slot" in
+	0) CI_KERNPART='0:HLOS'; CI_ROOTPART='rootfs' ;;
+	1) CI_KERNPART='0:HLOS_1'; CI_ROOTPART='rootfs_1' ;;
+	*) echo 'RE-CS-07: invalid BOOTCONFIG slot byte' >&2; return 1 ;;
+	esac
+	kern="$(find_mmc_part "$CI_KERNPART")" || return 1
+	root="$(find_mmc_part "$CI_ROOTPART")" || return 1
+	[ -b "$kern" ] && [ -b "$root" ] && [ "$kern" != "$root" ] || {
+		echo 'RE-CS-07: selected HLOS/rootfs block device is missing or aliased' >&2
+		return 1
+	}
+	# Discard inherited optional targets before calling the generic eMMC helper.
+	unset CI_DATAPART CI_DTBPART EMMC_DATA_DEV EMMC_DTB_DEV
+	export EMMC_KERN_DEV="$kern" EMMC_ROOT_DEV="$root"
+}
+
+re_cs_07_partition_bytes() {
+	local sectors
+	read -r sectors < "/sys/class/block/${1##*/}/size" || return 1
+	case "$sectors" in
+	''|*[!0-9]*) return 1 ;;
+	esac
+	[ "$sectors" -gt 0 ] || return 1
+	printf '%s\n' "$((sectors * 512))"
+}
+
+re_cs_07_tar_member_size() {
+	local image="$1" member="$2" tmp bytes
+	tmp="$(mktemp)" || return 1
+	# Do not pipe tar into wc: a truncated archive must retain tar's failure status.
+	if ! tar xf "$image" "$member" -O > "$tmp"; then
+		rm -f "$tmp"
+		return 1
+	fi
+	bytes="$(wc -c < "$tmp")" || { rm -f "$tmp"; return 1; }
+	rm -f "$tmp"
+	printf '%s\n' "$bytes"
+}
+
+re_cs_07_check_image() {
+	local image="$1" listing board_dir kernel_bytes root_bytes
+	local kernel_capacity root_capacity backup_bytes=0 tail_bytes=4096 root_end
+	re_cs_07_select_slot || return 1
+	listing="$(tar tf "$image")" || { echo 'RE-CS-07: invalid sysupgrade TAR' >&2; return 1; }
+	board_dir="$(printf '%s\n' "$listing" | grep -m 1 '^sysupgrade-.*/$')"
+	[ "$board_dir" = 'sysupgrade-jdcloud_re-cs-07/' ] || return 1
+	board_dir=${board_dir%/}
+	[ "$(printf '%s\n' "$listing" | grep -cx "$board_dir/kernel")" = 1 ] || return 1
+	[ "$(printf '%s\n' "$listing" | grep -cx "$board_dir/root")" = 1 ] || return 1
+	kernel_bytes="$(re_cs_07_tar_member_size "$image" "$board_dir/kernel")" || return 1
+	root_bytes="$(re_cs_07_tar_member_size "$image" "$board_dir/root")" || return 1
+	kernel_capacity="$(re_cs_07_partition_bytes "$EMMC_KERN_DEV")" || return 1
+	root_capacity="$(re_cs_07_partition_bytes "$EMMC_ROOT_DEV")" || return 1
+	if [ -n "$UPGRADE_BACKUP" ]; then
+		[ -f "$UPGRADE_BACKUP" ] || return 1
+		backup_bytes="$(wc -c < "$UPGRADE_BACKUP")" || return 1
+	fi
+	case "$kernel_bytes:$root_bytes:$kernel_capacity:$root_capacity:$backup_bytes" in
+	*[!0-9:]*|:*|*::*|*:) return 1 ;;
+	esac
+	[ "$kernel_bytes" -gt 0 ] && [ "$root_bytes" -gt 0 ] || return 1
+	# Enforce both the OEM layout limits and the selected devices' actual capacities.
+	[ "$kernel_bytes" -le 6291456 ] && [ "$kernel_bytes" -le "$kernel_capacity" ] || {
+		echo 'RE-CS-07: kernel exceeds selected HLOS capacity or 6 MiB limit' >&2
+		return 1
+	}
+	[ "$backup_bytes" -le "$tail_bytes" ] || tail_bytes="$backup_bytes"
+	root_end=$(( ((root_bytes + 65535) / 65536) * 65536 + tail_bytes ))
+	[ "$root_end" -le 62914560 ] && [ "$root_end" -le "$root_capacity" ] || {
+		echo 'RE-CS-07: rootfs plus aligned overlay/backup exceeds selected rootfs capacity' >&2
+		return 1
+	}
+}
+
+re_cs_07_do_upgrade() {
+	# Recheck the current slot, archive and backup immediately before any writes.
+	re_cs_07_check_image "$1" || return 1
+	emmc_do_upgrade "$1"
+}
+
 platform_check_image() {
-	return 0;
+	case "$(board_name)" in
+	jdcloud,re-cs-07) re_cs_07_check_image "$1" ;;
+	*) return 0 ;;
+	esac
+}
+
+platform_copy_config() {
+	case "$(board_name)" in
+	jdcloud,re-cs-07) emmc_copy_config ;;
+	esac
 }
 
 
