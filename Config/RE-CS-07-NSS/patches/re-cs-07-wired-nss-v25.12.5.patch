@@ -0,0 +1,24 @@
+#!/bin/sh /etc/rc.common
+# The upstream ECM service is normally started by its Wi-Fi pbuf helper.
+# This wired-only board has no Wi-Fi package, so start ECM after network.
+START=27
+STOP=89
+
+start() {
+	. /lib/functions.sh
+	[ "$(board_name)" = "jdcloud,re-cs-07" ] || return 0
+	[ -x /etc/init.d/qca-nss-ecm ] || return 1
+	[ -d /sys/module/ecm ] && return 0
+	/etc/init.d/qca-nss-ecm start
+	[ -d /sys/module/ecm ] || {
+		logger -t re-cs-07-nss "ECM failed to load; NSS acceleration is unavailable"
+		return 1
+	}
+}
+
+stop() {
+	. /lib/functions.sh
+	[ "$(board_name)" = "jdcloud,re-cs-07" ] || return 0
+	[ -x /etc/init.d/qca-nss-ecm ] || return 0
+	/etc/init.d/qca-nss-ecm stop
+}
